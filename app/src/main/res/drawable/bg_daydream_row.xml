<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#17363E" />
            <stroke
                android:width="3dp"
                android:color="#65D6CC" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#17363E" />
            <stroke
                android:width="1dp"
                android:color="#2D7378" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00151C27" />
            <stroke
                android:width="1dp"
                android:color="#25313D" />
            <corners android:radius="6dp" />
        </shape>
    </item>

</selector>
