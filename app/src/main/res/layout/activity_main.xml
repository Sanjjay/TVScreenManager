<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TV Screensaver Manager"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- TIMEOUT CONFIGURATIONS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="16dp">

        <!-- Left Column: Screen Off (Screensaver trigger) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Screensaver Start Timeout"
                android:textColor="#BBBBBB"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_off_5m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5m" android:layout_marginRight="4dp"/>
                <Button android:id="@+id/btn_off_15m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15m" android:layout_marginRight="4dp"/>
                <EditText android:id="@+id/et_off_custom" android:layout_width="60dp" android:layout_height="wrap_content" android:hint="Min" android:inputType="number" android:textColor="#FFFFFF" android:background="#222222" android:padding="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column: Deep Sleep Timeout -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. System Sleep Timeout"
                android:textColor="#BBBBBB"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_sleep_30m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30m" android:layout_marginRight="4dp"/>
                <Button android:id="@+id/btn_sleep_never" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Never" android:layout_marginRight="4dp"/>
                <EditText android:id="@+id/et_sleep_custom" android:layout_width="60dp" android:layout_height="wrap_content" android:hint="Min" android:inputType="number" android:textColor="#FFFFFF" android:background="#222222" android:padding="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_apply_timeouts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Custom Timeouts"
        android:layout_marginBottom="16dp"/>

    <!-- DAYDREAM SELECTOR -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3. Detected Daydream Apps (Tick to Enable)"
        android:textColor="#BBBBBB"
        android:textSize="16sp"
        android:layout_marginBottom="6dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A1A"
        android:padding="8dp">

        <RadioGroup
            android:id="@+id/rg_daydream_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>