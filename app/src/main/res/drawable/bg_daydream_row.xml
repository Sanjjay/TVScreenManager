<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape>
            <solid android:color="#1F3D48" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="#65D6CC" />
        </shape>
    </item>

    <item android:state_checked="true">
        <shape>
            <solid android:color="#17363E" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#65D6CC" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#151C27" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#263447" />
        </shape>
    </item>

</selector>
