<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Theme.Leanback"
        parent="android:style/Theme.Material.NoActionBar.Fullscreen">

        <!-- App background -->
        <item name="android:windowBackground">#0B1018</item>

        <!-- No action bar -->
        <item name="android:windowActionModeOverlay">true</item>

        <!-- TV-friendly navigation -->
        <item name="android:fontFamily">sans</item>

        <!-- Keep system bars dark -->
        <item name="android:statusBarColor">#0B1018</item>
        <item name="android:navigationBarColor">#0B1018</item>

        <!-- Light text on dark UI -->
        <item name="android:textColorPrimary">#F5F7FA</item>
        <item name="android:textColorSecondary">#8995A5</item>

        <!-- Prevent the default window from flashing white -->
        <item name="android:colorAccent">#65D6CC</item>

    </style>

</resources>
